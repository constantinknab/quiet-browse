{
  "name": "quiet-browse",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "description": "A local, reversible Chrome extension for calmer pages.",
  "scripts": {
    "format": "prettier --write \"extension/**/*.{js,json,css,html}\" \"demo/**/*.{js,css,html}\" \"website/**/*.{css,html}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"docs/**/*.json\" package.json package-lock.json .prettierrc.json",
    "format:check": "prettier --check \"extension/**/*.{js,json,css,html}\" \"demo/**/*.{js,css,html}\" \"website/**/*.{css,html}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"docs/**/*.json\" package.json package-lock.json .prettierrc.json",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "package": "python3 scripts/package.py",
    "audit-package": "python3 scripts/audit_package.py",
    "verify": "npm run format:check && npm test && npm run check && npm run package && npm run audit-package",
    "demo": "python3 scripts/serve_demo.py"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
